{
  "name": "FleetCharge emulator development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=fleetcharge-venv-${devcontainerId},target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=fleetcharge-models-${devcontainerId},target=/home/vscode/.ollama,type=volume"
  ],
  "forwardPorts": [8001],
  "portsAttributes": {
    "8001": {
      "label": "FleetCharge API",
      "onAutoForward": "notify"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
