# Direct local endpoint; scripts.ci, scripts.test_ollama and scripts.demo override
# COSMOS_ENDPOINT with their owned emulator's dynamically assigned loopback port.
# Copy to .env; process environment variables take precedence.
COSMOS_ENDPOINT=http://127.0.0.1:8081
COSMOS_DATABASE=fleetchargetest-demo
# Documented public emulator key; never use for Azure. vNext does not enforce authentication.
COSMOS_KEY=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
AGENT_MODEL_MODE=ollama
OLLAMA_MODEL=fleetcharge-phi3.5:latest
OLLAMA_ENDPOINT=http://127.0.0.1:11434/v1
FLEETCHARGE_TIMEOUT_SECONDS=300
# Fixed sample clock matches seeded telemetry/reservations; not a Cosmos/Ollama setting.
FLEETCHARGE_REVIEW_AT=2026-10-19T12:30:00-07:00
